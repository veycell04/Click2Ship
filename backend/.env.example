SHIPAIR_BASE_URL=https://shipair.site/api/v1
SHIPAIR_API_KEY=
CLICK2SHIP_EXTENSION_ID=
NODE_ENV=development
PORT=3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:3001
# Required in production. Example: postgresql://user:password@host:5432/click2ship
DATABASE_URL=
EASYPOST_API_KEY=
SHIPDIME_DISCOUNT_PERCENT=20
BOOK_SHIPPING_ENABLED=true
# Optional opt-in. Leave unset to preserve current Book pricing.
# Integer/decimal percentage from 0 through 100. 40 means 40%, not 0.40.
# BOOK_DISCOUNT_PERCENT=40
# Legacy fallback only: ignored when BOOK_DISCOUNT_PERCENT is configured.
BOOK_TARGET_PRICE_CENTS=399
# Legacy Media Mail reference-plus-margin rule; real ShipAir cost is not known at quote time.
BOOK_MIN_MARGIN_CENTS=25
# Set only after confirming the Media Mail label type ID returned by ShipAir /label-types.
SHIPAIR_MEDIA_MAIL_LABEL_TYPE_ID=
